# PostgreSQL connection
DB_HOST=localhost
DB_PORT=5432
DB_NAME=divineconnect
DB_USER=postgres
DB_PASSWORD=your_password_here

# Server
PORT=5000
NODE_ENV=development

# CORS - your frontend URL
CLIENT_URL=http://localhost:5173

# GitHub — required for the admin panel's Prayers module, which commits
# .md edits straight to your repo (Vercel then auto-deploys on push).
# GITHUB_TOKEN needs "repo" (contents: read & write) access to GITHUB_REPO.
GITHUB_TOKEN=
GITHUB_OWNER=your-github-username-or-org
GITHUB_REPO=your-repo-name
GITHUB_BRANCH=main
# Only needed if this backend lives in a subfolder of a monorepo, e.g.
# GITHUB_PRAYERS_PATH=divineconnect-backend/prayers
GITHUB_PRAYERS_PATH=prayers
